# Copy to .env and fill in. Loaded manually by your shell or via direnv.
AWEBO_CATALOG_TYPE=glue
AWEBO_CATALOG_NAME=lake
AWEBO_GLUE_WAREHOUSE=s3://your-bucket/warehouse

AWS_REGION=us-east-1
# Use either profile OR static keys (boto3 chain applies):
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWEBO_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/awebo

# Optional tunables
# AWEBO_STREAMING_THRESHOLD_MB=512
# AWEBO_TEMP_DIR=/tmp/awebo
